{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "spehr-mcp",
      "version": "0.1.0",
      "title": "S.P.E.H.R Clinical MCP"
    },
    "tools": [
      {
        "name": "list_patients",
        "title": "List patients",
        "description": "List simulated patients in the S.P.E.H.R clinical workspace. Returns MRN, name, and facility for up to `limit` patients.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of patients to return (1-100)."
            },
            "facility": {
              "type": "string",
              "description": "Optional facility name to filter by."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_patient_chart",
        "title": "Get patient chart",
        "description": "Fetch a simulated patient's chart summary by MRN, including demographics, chief complaint, and coded terminology.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mrn": {
              "type": "string",
              "minLength": 1,
              "description": "Medical Record Number of the patient."
            }
          },
          "required": [
            "mrn"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_safety_alerts",
        "title": "List clinical safety alerts",
        "description": "List recent clinical safety alerts (drug-drug, drug-allergy, etc.) from the S.P.E.H.R workspace, optionally filtered by MRN or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mrn": {
              "type": "string",
              "description": "Filter by patient MRN."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending_review",
                "resolved",
                "dismissed"
              ],
              "description": "Filter by alert status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
